{
  "name": "motion-video",
  "private": true,
  "scripts": {
    "narrate": "python3 narrate.py script.json --out public --fps 30 --srt out/narration.srt",
    "preview": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts Main out/video.mp4 --codec=h264 --crf=18",
    "render:3d": "remotion render src/index.ts Main out/video.mp4 --codec=h264 --crf=18 --gl=angle"
  },
  "dependencies": {
    "@remotion/cli": "4.0.290",
    "remotion": "4.0.290",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": { "typescript": "5.6.3", "@types/react": "18.3.12" }
}
